{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alvorada.local/schemas/governance-common.schema.json",
  "title": "Common governance record",
  "description": "Shared, human-readable fields. Schema validity does not establish authority.",
  "type": "object",
  "properties": {
    "rule_id": {"type": "string", "minLength": 1},
    "rule_type": {"type": "string", "minLength": 1},
    "authority_source": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "scope": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "applies_to": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "must": {"type": "array", "items": {"type": "string"}},
    "must_not": {"type": "array", "items": {"type": "string"}},
    "may": {"type": "array", "items": {"type": "string"}},
    "exceptions": {"type": "array", "items": {"type": "string"}},
    "counter_authority": {"type": "array", "items": {"type": "string"}},
    "review_path": {"type": "array", "items": {"type": "string"}},
    "reversibility": {
      "type": "object",
      "properties": {
        "formal": {"enum": ["REVERSIBLE", "IRREVERSIBLE", "UNKNOWN"]},
        "practical": {"enum": ["REVERSIBLE", "PARTIAL", "IRREVERSIBLE", "UNKNOWN"]},
        "method": {"type": "string"}
      },
      "required": ["formal", "practical"],
      "additionalProperties": false
    },
    "supersedes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "replaces": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      ]
    },
    "dependencies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "effective_date": {"type": ["string", "null"], "format": "date-time"},
    "expiry": {"type": ["string", "null"], "format": "date-time"},
    "status": {
      "enum": [
        "PROPOSED",
        "ACTIVE",
        "INACTIVE",
        "SUPERSEDED",
        "EXPIRED",
        "UNKNOWN",
        "UNRESOLVED",
        "DISPUTED",
        "NOT TESTED",
        "INAPPLICABLE"
      ]
    },
    "human_explanation": {"type": "string", "minLength": 1},
    "provenance": {
      "type": "object",
      "properties": {
        "artifact": {"type": ["string", "null"], "minLength": 1},
        "authorized_by": {"type": ["string", "null"], "minLength": 1},
        "status": {"enum": ["DOCUMENTED", "UNKNOWN", "INCOMPLETE", "DISPUTED"]},
        "recorded_at": {"type": ["string", "null"], "format": "date-time"}
      },
      "additionalProperties": false
    }
  },
  "required": ["rule_id", "rule_type", "purpose", "status", "human_explanation"],
  "additionalProperties": true
}
