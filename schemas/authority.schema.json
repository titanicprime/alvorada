{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alvorada.local/schemas/authority.schema.json",
  "title": "Authority record",
  "description": "Records a claimed authority and its provenance without making the claim valid.",
  "type": "object",
  "properties": {
    "rule_type": {"const": "authority"},
    "authority_basis": {"enum": ["FOUNDATIONAL", "DERIVED"]},
    "holder": {"type": "string", "minLength": 1},
    "holder_type": {"enum": ["human", "office", "role", "artificial_intelligence", "UNKNOWN"]},
    "foundational_basis": {
      "type": "object",
      "properties": {
        "claim_type": {"const": "HUMAN_AUTHORITY_CLAIM"},
        "evidence": {
          "type": "array",
          "items": {"type": "string"}
        },
        "provenance_status": {"enum": ["EVIDENCED", "UNKNOWN", "INCOMPLETE", "DISPUTED"]}
      },
      "required": ["claim_type", "evidence", "provenance_status"],
      "additionalProperties": false
    }
  },
  "required": ["authority_basis", "holder", "holder_type", "scope", "provenance"],
  "allOf": [
    {"$ref": "governance-common.schema.json"},
    {
      "if": {
        "properties": {"authority_basis": {"const": "FOUNDATIONAL"}},
        "required": ["authority_basis"]
      },
      "then": {
        "required": ["foundational_basis"],
        "not": {"required": ["authority_source"]}
      },
      "else": {
        "required": ["authority_source"],
        "properties": {
          "provenance": {
            "required": ["artifact", "authorized_by"]
          }
        }
      }
    }
  ]
}
